{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "."
  },
  "include": [
    "scripts/**/*.ts"
  ],
  "exclude": [
    "dist",
    "lib",
    "node_modules"
  ]
}
